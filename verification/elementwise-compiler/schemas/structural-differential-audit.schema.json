{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saltyrn.local/schemas/structural-differential-audit.schema.json",
  "title": "SaltyRN exact structural/schedule lowering trace audit",
  "type": "object",
  "required": [
    "artifact_kind",
    "schema_version",
    "coverage_scope",
    "verdict_definition",
    "selected_semantic_families",
    "registry_path",
    "registry_file_sha256",
    "registry_sha256",
    "intrinsic_audit_path",
    "intrinsic_audit_file_sha256",
    "intrinsic_audit_sha256",
    "review_plan_path",
    "review_plan_file_sha256",
    "review_plan_sha256",
    "generator_mutation_probes",
    "ledger_projection_path",
    "ledger_join_key",
    "counts",
    "subjects",
    "audit_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {"const": "structural-lowering-trace-audit"},
    "schema_version": {"const": 1},
    "coverage_scope": {"type": "string", "pattern": "not-isa-adequacy"},
    "verdict_definition": {"type": "string", "pattern": "not an ISA correctness proof"},
    "selected_semantic_families": {
      "type": "array",
      "prefixItems": [
        {"const": "S0-schedule-setvl"},
        {"const": "S1-structural-plain"},
        {"const": "S2-structural-immediate"}
      ],
      "items": false
    },
    "registry_path": {"type": "string"},
    "registry_file_sha256": {"$ref": "#/$defs/sha256"},
    "registry_sha256": {"$ref": "#/$defs/sha256"},
    "intrinsic_audit_path": {"type": "string"},
    "intrinsic_audit_file_sha256": {"$ref": "#/$defs/sha256"},
    "intrinsic_audit_sha256": {"$ref": "#/$defs/sha256"},
    "review_plan_path": {"type": "string"},
    "review_plan_file_sha256": {"$ref": "#/$defs/sha256"},
    "review_plan_sha256": {"$ref": "#/$defs/sha256"},
    "generator_mutation_probes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["probe", "status", "expected"],
        "properties": {
          "probe": {"type": "string", "minLength": 1},
          "status": {"const": "passed"},
          "expected": {"type": "string", "minLength": 1}
        }
      }
    },
    "ledger_projection_path": {
      "const": "verification/elementwise-compiler/StructuralDifferentialAuditLedger.csv"
    },
    "ledger_join_key": {"const": "capability_id"},
    "counts": {
      "type": "object",
      "required": [
        "subjects",
        "passed_subjects",
        "l2_traceable_subjects",
        "l3_generator_mutation_subjects",
        "c_call_sites",
        "manifest_bindings",
        "generator_mutation_probes",
        "isa_correctness_validated_subjects",
        "semantic_correspondence_pending_subjects",
        "families",
        "operations"
      ],
      "properties": {
        "subjects": {"const": 68},
        "passed_subjects": {"const": 68},
        "l2_traceable_subjects": {"type": "integer", "minimum": 0},
        "l3_generator_mutation_subjects": {"type": "integer", "minimum": 0},
        "c_call_sites": {"type": "integer", "minimum": 68},
        "manifest_bindings": {"type": "integer", "minimum": 68},
        "generator_mutation_probes": {"const": 4},
        "isa_correctness_validated_subjects": {"const": 0},
        "semantic_correspondence_pending_subjects": {"const": 68},
        "families": {"type": "object"},
        "operations": {"type": "object"}
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 68,
      "maxItems": 68,
      "items": {"$ref": "#/$defs/subject"}
    },
    "audit_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject": {
      "type": "object",
      "required": [
        "capability_id",
        "semantic_family",
        "architecture",
        "spelling",
        "function_type",
        "role",
        "descriptor",
        "official_pinned_source",
        "architecture_conditions",
        "c_calls",
        "lowering",
        "provenance_checks",
        "evidence_level",
        "semantic_correspondence_status",
        "coverage_scope",
        "status",
        "issues",
        "evidence_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "capability_id": {"type": "string", "pattern": "^intrinsic:(neon|rvv):"},
        "semantic_family": {"enum": [
          "S0-schedule-setvl",
          "S1-structural-plain",
          "S2-structural-immediate"
        ]},
        "architecture": {"enum": ["neon", "rvv"]},
        "spelling": {"type": "string", "minLength": 1},
        "function_type": {"type": "string", "minLength": 1},
        "role": {"enum": ["structural", "schedule"]},
        "descriptor": {"type": "object"},
        "official_pinned_source": {"type": "object"},
        "architecture_conditions": {"type": "array", "items": {"type": "string"}},
        "c_calls": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "lowering": {
          "type": "object",
          "required": [
            "renderer",
            "structural_operation",
            "operand_roles",
            "all_source_arguments_accounted_for",
            "anchors",
            "binding_guard"
          ],
          "properties": {
            "renderer": {"const": "production-case-emitter"},
            "structural_operation": {"type": "string", "minLength": 1},
            "operand_roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "all_source_arguments_accounted_for": {"const": true},
            "anchors": {"type": "array", "minItems": 1, "items": {"type": "object"}},
            "binding_guard": {"type": "object"}
          }
        },
        "provenance_checks": {"type": "object"},
        "evidence_level": {"enum": ["L2-traceable-lowering", "L3-generator-mutation"]},
        "semantic_correspondence_status": {"enum": [
          "not-independently-validated",
          "generator-boundary-validated-only"
        ]},
        "coverage_scope": {"type": "string", "pattern": "not-isa-adequacy"},
        "status": {"const": "passed"},
        "issues": {"type": "array", "maxItems": 0},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
