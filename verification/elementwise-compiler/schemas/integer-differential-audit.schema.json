{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saltyrn.local/schemas/integer-differential-audit.schema.json",
  "title": "SaltyRN exact P1 integer intrinsic differential audit",
  "type": "object",
  "required": [
    "artifact_kind",
    "schema_version",
    "evidence_level",
    "coverage_scope",
    "state_exclusions",
    "verdict_definition",
    "semantic_family_source_path",
    "semantic_family_source_sha256",
    "selected_semantic_families",
    "explicit_regression_capability_ids",
    "registry_path",
    "registry_file_sha256",
    "registry_sha256",
    "intrinsic_audit_path",
    "intrinsic_audit_file_sha256",
    "intrinsic_audit_sha256",
    "lean_backend",
    "toolchain_inventory",
    "ledger_projection_path",
    "ledger_join_key",
    "counts",
    "subjects",
    "audit_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {"const": "integer-intrinsic-differential-audit"},
    "schema_version": {"const": 1},
    "evidence_level": {"const": "L3-sampled"},
    "coverage_scope": {"type": "string", "pattern": "not-exhaustive"},
    "state_exclusions": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string"}
    },
    "verdict_definition": {"type": "string", "pattern": "not a proof"},
    "semantic_family_source_path": {"type": "string"},
    "semantic_family_source_sha256": {"$ref": "#/$defs/sha256"},
    "selected_semantic_families": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": [
        "I2-integer-saturating-narrow-shift",
        "I3-integer-mode-sensitive-rounding"
      ]}
    },
    "explicit_regression_capability_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^intrinsic:rvv:"}
    },
    "registry_path": {"type": "string"},
    "registry_file_sha256": {"$ref": "#/$defs/sha256"},
    "registry_sha256": {"$ref": "#/$defs/sha256"},
    "intrinsic_audit_path": {"type": "string"},
    "intrinsic_audit_file_sha256": {"$ref": "#/$defs/sha256"},
    "intrinsic_audit_sha256": {"$ref": "#/$defs/sha256"},
    "lean_backend": {"type": "object"},
    "toolchain_inventory": {"type": "object"},
    "ledger_projection_path": {
      "const": "verification/elementwise-compiler/IntegerDifferentialAuditLedger.csv"
    },
    "ledger_join_key": {"const": "capability_id"},
    "counts": {
      "type": "object",
      "required": [
        "subjects",
        "passed_subjects",
        "blocked_subjects",
        "mismatch_subjects",
        "test_vectors",
        "executed_vectors",
        "blocked_vectors"
      ],
      "additionalProperties": false,
      "properties": {
        "subjects": {"type": "integer", "minimum": 1},
        "passed_subjects": {"type": "integer", "minimum": 0},
        "blocked_subjects": {"type": "integer", "minimum": 0},
        "mismatch_subjects": {"type": "integer", "minimum": 0},
        "test_vectors": {"type": "integer", "minimum": 1},
        "executed_vectors": {"type": "integer", "minimum": 0},
        "blocked_vectors": {"type": "integer", "minimum": 0}
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/subject"}
    },
    "audit_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bits": {"type": "string", "pattern": "^0x[0-9A-F]+$"},
    "case": {
      "type": "object",
      "required": [
        "case_id",
        "inputs_bits",
        "input_widths",
        "shift",
        "vxrm",
        "observed_lane",
        "output_width",
        "expected_bits",
        "actual_bits",
        "verdict"
      ],
      "additionalProperties": false,
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "inputs_bits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/bits"}
        },
        "input_widths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"enum": [8, 16, 32]}
        },
        "shift": {"type": ["integer", "null"], "minimum": 0},
        "vxrm": {"type": ["integer", "null"], "minimum": 0, "maximum": 3},
        "observed_lane": {"type": "integer", "minimum": 0},
        "output_width": {"enum": [8, 16, 32]},
        "expected_bits": {"$ref": "#/$defs/bits"},
        "actual_bits": {"oneOf": [{"$ref": "#/$defs/bits"}, {"type": "null"}]},
        "verdict": {"enum": ["passed", "blocked", "mismatch"]}
      }
    },
    "subject": {
      "type": "object",
      "required": [
        "capability_id",
        "semantic_family",
        "subject_scope",
        "registry_used",
        "architecture",
        "spelling",
        "function_type",
        "immediate_constraints",
        "architecture_conditions",
        "c_calls",
        "real_c_call_scope",
        "official_pinned_source",
        "lean",
        "oracle_backend",
        "evidence_level",
        "coverage_scope",
        "state_effect_scope",
        "cases",
        "status",
        "evidence_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "capability_id": {"type": "string", "pattern": "^intrinsic:(neon|rvv):"},
        "semantic_family": {"enum": [
          "I2-integer-saturating-narrow-shift",
          "I3-integer-mode-sensitive-rounding",
          "REPAIRED-vssra-shift-mask-regression"
        ]},
        "subject_scope": {"enum": [
          "current-P1-exact",
          "explicit-repaired-regression-unused"
        ]},
        "registry_used": {"type": "boolean"},
        "architecture": {"enum": ["neon", "rvv"]},
        "spelling": {"type": "string", "minLength": 1},
        "function_type": {"type": "string", "minLength": 1},
        "immediate_constraints": {"type": "array"},
        "architecture_conditions": {"type": "array", "items": {"type": "string"}},
        "c_calls": {"type": "array", "items": {"type": "object"}},
        "real_c_call_scope": {"type": "string"},
        "official_pinned_source": {"type": "object"},
        "lean": {"type": "object"},
        "oracle_backend": {"type": "object"},
        "evidence_level": {"const": "L3-sampled"},
        "coverage_scope": {"type": "string", "pattern": "not-exhaustive"},
        "state_effect_scope": {"type": "string"},
        "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
        "status": {"enum": ["passed", "blocked", "mismatch"]},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
