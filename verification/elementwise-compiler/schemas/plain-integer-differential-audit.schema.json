{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saltyrn.local/schemas/plain-integer-differential-audit.schema.json",
  "title": "SaltyRN exact plain integer intrinsic differential audit",
  "type": "object",
  "required": [
    "artifact_kind", "schema_version", "evidence_level", "coverage_scope",
    "verdict_definition", "selected_semantic_families",
    "explicit_legacy_cleanup_capability_ids", "registry_path",
    "registry_sha256", "registry_file_sha256", "intrinsic_audit_path",
    "intrinsic_audit_sha256", "intrinsic_audit_file_sha256",
    "review_plan_path", "review_plan_file_sha256", "lean_backend",
    "toolchain_inventory", "broadcast_provenance_audit",
    "ledger_projection_path", "ledger_join_key", "counts", "subjects",
    "audit_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {"const": "plain-integer-intrinsic-differential-audit"},
    "schema_version": {"const": 1},
    "evidence_level": {"const": "L3-sampled"},
    "coverage_scope": {"type": "string", "pattern": "not-exhaustive"},
    "verdict_definition": {"type": "string", "pattern": "not a full proof"},
    "selected_semantic_families": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "items": {"enum": ["I0-integer-plain", "I1-integer-broadcast-normalized"]}
    },
    "explicit_legacy_cleanup_capability_ids": {
      "type": "array", "minItems": 0, "maxItems": 0, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^intrinsic:neon:v(max|min)q?_s8:"}
    },
    "registry_path": {"type": "string"},
    "registry_sha256": {"$ref": "#/$defs/sha256"},
    "registry_file_sha256": {"$ref": "#/$defs/sha256"},
    "intrinsic_audit_path": {"type": "string"},
    "intrinsic_audit_sha256": {"$ref": "#/$defs/sha256"},
    "intrinsic_audit_file_sha256": {"$ref": "#/$defs/sha256"},
    "review_plan_path": {"type": "string"},
    "review_plan_file_sha256": {"$ref": "#/$defs/sha256"},
    "lean_backend": {"type": "object"},
    "toolchain_inventory": {"type": "object"},
    "broadcast_provenance_audit": {
      "type": "object",
      "required": ["positive_manifest_path", "positive_occurrences", "nonuniform_vector_mutation", "claim"],
      "properties": {
        "positive_occurrences": {"type": "array", "minItems": 3},
        "nonuniform_vector_mutation": {
          "type": "object", "required": ["status", "error_type", "message"],
          "properties": {"status": {"const": "passed-rejected"}}
        }
      }
    },
    "ledger_projection_path": {"const": "verification/elementwise-compiler/PlainIntegerDifferentialAuditLedger.csv"},
    "ledger_join_key": {"const": "capability_id"},
    "counts": {
      "type": "object",
      "required": ["subjects", "current_subjects", "legacy_cleanup_candidates", "passed_subjects", "conditional_subjects", "blocked_subjects", "mismatch_subjects", "test_vectors", "executed_vectors"],
      "additionalProperties": false,
      "properties": {
        "subjects": {"const": 65}, "current_subjects": {"const": 65},
        "legacy_cleanup_candidates": {"const": 0},
        "passed_subjects": {"type": "integer", "minimum": 0},
        "conditional_subjects": {"type": "integer", "minimum": 0},
        "blocked_subjects": {"type": "integer", "minimum": 0},
        "mismatch_subjects": {"type": "integer", "minimum": 0},
        "test_vectors": {"type": "integer", "minimum": 1},
        "executed_vectors": {"type": "integer", "minimum": 0}
      }
    },
    "subjects": {"type": "array", "minItems": 65, "maxItems": 65, "items": {"$ref": "#/$defs/subject"}},
    "audit_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject": {
      "type": "object",
      "required": [
        "capability_id", "semantic_family", "subject_scope", "registry_used",
        "architecture", "spelling", "function_type", "descriptor_sha256",
        "descriptor_operand_lowering", "c_calls", "official_pinned_source",
        "lean", "oracle_backend", "evidence_level", "coverage_scope",
        "context_condition", "cleanup_recommendation", "cases",
        "execution_status", "status", "evidence_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "capability_id": {"type": "string", "pattern": "^intrinsic:(neon|rvv):"},
        "semantic_family": {"type": "string"},
        "subject_scope": {"enum": ["current-exact", "explicit-unused-cleanup-candidate"]},
        "registry_used": {"type": "boolean"},
        "architecture": {"enum": ["neon", "rvv"]},
        "spelling": {"type": "string", "minLength": 1},
        "function_type": {"type": "string", "minLength": 1},
        "descriptor_sha256": {"$ref": "#/$defs/sha256"},
        "descriptor_operand_lowering": {"type": "array", "minItems": 1},
        "c_calls": {"type": "array"},
        "official_pinned_source": {"type": "object"},
        "lean": {"type": "object"},
        "oracle_backend": {"type": "object"},
        "evidence_level": {"const": "L3-sampled"},
        "coverage_scope": {"type": "string", "pattern": "not-exhaustive"},
        "context_condition": {"type": ["string", "null"]},
        "cleanup_recommendation": {"type": ["string", "null"]},
        "cases": {"type": "array", "minItems": 1},
        "execution_status": {"enum": ["passed", "blocked", "mismatch"]},
        "status": {"enum": ["passed", "conditional", "blocked", "mismatch"]},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
