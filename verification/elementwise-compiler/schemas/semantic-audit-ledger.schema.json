{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Elementwise semantic audit ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kind",
    "schema_version",
    "join_key",
    "claim_scope",
    "parents",
    "counts",
    "columns",
    "rows",
    "ledger_sha256"
  ],
  "properties": {
    "artifact_kind": {"const": "elementwise-semantic-audit-ledger"},
    "schema_version": {"const": 1},
    "join_key": {"const": "capability_id"},
    "claim_scope": {"type": "string", "minLength": 1},
    "parents": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variants", "used", "unused", "current_reviews", "verdicts", "evidence_levels"],
      "properties": {
        "variants": {"type": "integer", "minimum": 1},
        "used": {"type": "integer", "minimum": 0},
        "unused": {"type": "integer", "minimum": 0},
        "current_reviews": {"type": "integer", "minimum": 0},
        "verdicts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "evidence_levels": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    },
    "columns": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["capability_id", "architecture", "spelling", "deep_verdict", "evidence_level"],
        "properties": {
          "capability_id": {"type": "string", "pattern": "^intrinsic:"},
          "architecture": {"enum": ["neon", "rvv"]},
          "spelling": {"type": "string", "minLength": 1},
          "deep_verdict": {"enum": ["confirmed", "conditional", "needs_deep_audit", "suspected_bug", "confirmed_bug", "unused_unreviewed"]},
          "evidence_level": {"type": "string", "pattern": "^L[1-4]"}
        }
      }
    },
    "ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
