{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saltyrn.local/schemas/fp-differential-audit.schema.json",
  "title": "SaltyRN exact FP intrinsic differential audit",
  "type": "object",
  "required": [
    "artifact_kind",
    "schema_version",
    "evidence_level",
    "coverage_scope",
    "verdict_definition",
    "registry_path",
    "registry_file_sha256",
    "registry_sha256",
    "intrinsic_audit_path",
    "intrinsic_audit_file_sha256",
    "intrinsic_audit_sha256",
    "review_plan_path",
    "review_plan_file_sha256",
    "review_plan_sha256",
    "lean_backend",
    "toolchain_inventory",
    "ledger_projection_path",
    "ledger_join_key",
    "counts",
    "subjects",
    "audit_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {"const": "fp-intrinsic-differential-audit"},
    "schema_version": {"const": 2},
    "evidence_level": {"const": "L3-sampled"},
    "coverage_scope": {"type": "string", "pattern": "not-exhaustive"},
    "verdict_definition": {"type": "string", "pattern": "not a proof"},
    "registry_path": {"type": "string"},
    "registry_file_sha256": {"$ref": "#/$defs/sha256"},
    "registry_sha256": {"$ref": "#/$defs/sha256"},
    "intrinsic_audit_path": {"type": "string"},
    "intrinsic_audit_file_sha256": {"$ref": "#/$defs/sha256"},
    "intrinsic_audit_sha256": {"$ref": "#/$defs/sha256"},
    "review_plan_path": {"const": "verification/elementwise-compiler/IntrinsicReviewPlan.json"},
    "review_plan_file_sha256": {"$ref": "#/$defs/sha256"},
    "review_plan_sha256": {"$ref": "#/$defs/sha256"},
    "lean_backend": {"type": "object"},
    "toolchain_inventory": {"type": "object"},
    "ledger_projection_path": {"const": "verification/elementwise-compiler/FPDifferentialAuditLedger.csv"},
    "ledger_join_key": {"const": "capability_id"},
    "counts": {
      "type": "object",
      "required": [
        "subjects",
        "passed_subjects",
        "blocked_subjects",
        "mismatch_subjects",
        "test_vectors",
        "executed_vectors",
        "blocked_vectors"
      ],
      "additionalProperties": false,
      "properties": {
        "subjects": {"const": 28},
        "passed_subjects": {"type": "integer", "minimum": 0},
        "blocked_subjects": {"type": "integer", "minimum": 0},
        "mismatch_subjects": {"type": "integer", "minimum": 0},
        "test_vectors": {"type": "integer", "minimum": 1},
        "executed_vectors": {"type": "integer", "minimum": 0},
        "blocked_vectors": {"type": "integer", "minimum": 0}
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28,
      "items": {"$ref": "#/$defs/subject"}
    },
    "audit_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bits": {"type": "string", "pattern": "^0x[0-9A-F]{8}$"},
    "case": {
      "type": "object",
      "required": ["case_id", "inputs_bits", "expected_bits", "actual_bits", "verdict"],
      "additionalProperties": false,
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "inputs_bits": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/bits"}},
        "expected_bits": {"$ref": "#/$defs/bits"},
        "actual_bits": {"oneOf": [{"$ref": "#/$defs/bits"}, {"type": "null"}]},
        "verdict": {"enum": ["passed", "blocked", "mismatch"]}
      }
    },
    "subject": {
      "type": "object",
      "required": [
        "capability_id",
        "review_family",
        "architecture",
        "spelling",
        "function_type",
        "architecture_conditions",
        "descriptor",
        "c_calls",
        "official_pinned_source",
        "official_selector",
        "lean",
        "oracle_backend",
        "evidence_level",
        "coverage_scope",
        "case_matrix",
        "cases",
        "status",
        "evidence_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "capability_id": {"type": "string", "pattern": "^intrinsic:(neon|rvv):"},
        "review_family": {"type": "string", "pattern": "^FP[0-4]-"},
        "architecture": {"enum": ["neon", "rvv"]},
        "spelling": {"type": "string", "minLength": 1},
        "function_type": {"type": "string", "minLength": 1},
        "architecture_conditions": {"type": "array", "items": {"type": "string"}},
        "descriptor": {
          "type": "object",
          "required": ["descriptor_sha256", "shape", "argument_count", "parameters", "immediate_constraints", "operand_mapping"],
          "additionalProperties": false,
          "properties": {
            "descriptor_sha256": {"$ref": "#/$defs/sha256"},
            "shape": {"type": "string"},
            "argument_count": {"type": "integer", "minimum": 1},
            "parameters": {"type": "array", "minItems": 1, "items": {"type": "object"}},
            "immediate_constraints": {"type": "array", "items": {"type": "object"}},
            "operand_mapping": {"type": "array", "minItems": 1, "items": {"type": "object"}}
          }
        },
        "c_calls": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "official_pinned_source": {"type": "object"},
        "official_selector": {
          "type": "object",
          "required": ["api", "isa"],
          "additionalProperties": false,
          "properties": {"api": {"type": "string"}, "isa": {"type": "string"}}
        },
        "lean": {"type": "object"},
        "oracle_backend": {"type": "object"},
        "evidence_level": {"const": "L3-sampled"},
        "coverage_scope": {"type": "string", "pattern": "not-exhaustive"},
        "case_matrix": {
          "type": "object",
          "required": ["matrix_id", "reused", "reused_by_capability_ids", "reuse_scope"],
          "additionalProperties": false,
          "properties": {
            "matrix_id": {"type": "string"},
            "reused": {"type": "boolean"},
            "reused_by_capability_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "reuse_scope": {"type": "string", "pattern": "independent"}
          }
        },
        "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
        "status": {"enum": ["passed", "blocked", "mismatch"]},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
