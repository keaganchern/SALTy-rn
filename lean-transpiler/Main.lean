import Transpiler
import Transpiler.License

open Transpiler

private def usage := "Usage: neon2rvv <transpile|roundtrip|ast|emit|lean|check> INPUT [-o OUTPUT] [--kernel] [--arch arm64|arm]\n\
  transpile  C<NEON> -> C<RVV>, with only required helper definitions\n\
  roundtrip  C -> AST -> canonical C (no preprocessing or lowering)\n\
  ast        C -> JSON AST (exact literal spellings retained)\n\
  emit       JSON AST -> C\n\
  lean       C -> a Lean definition of the parsed Program\n\
  check      Parse C and check canonical printer/parser stability\n\
  --kernel   Promote the leading SALTy parameter-struct comment and include salty_compat.h\n\
Architecture conditionals are selected only by transpile. Unknown conditions are errors."

private def run (args : List String) : IO Unit := do
  if args == ["--help"] || args.isEmpty then IO.println usage; return
  let command := args[0]!
  let some input := args[1]? | throw (IO.userError usage)
  let mut output : Option String := none
  let mut kernel := false
  let mut arch := SourceArch.arm64
  let mut i := 2
  while i < args.length do
    match args[i]! with
    | "--kernel" => kernel := true; i := i+1
    | "-o" =>
      let some path := args[i+1]? | throw (IO.userError "-o requires a file")
      output := some path; i := i+2
    | "--arch" =>
      let some value := args[i+1]? | throw (IO.userError "--arch requires arm64 or arm")
      arch ← match value with
        | "arm64" => pure .arm64 | "arm" => pure .arm
        | _ => throw (IO.userError "--arch requires arm64 or arm")
      i := i+2
    | flag => throw (IO.userError s!"unknown option {flag}")
  let source ← IO.FS.readFile input
  let process : Except String String := do
    if command == "emit" then
      let json ← Lean.Json.parse source
      let program : Program ← Lean.fromJson? json
      return printC program
    let source := if kernel then exposeKernelParams source else source
    let source ← if command == "transpile" then selectArchitecture source arch else pure source
    let program ← parseC source
    match command with
    | "roundtrip" => pure (printC program)
    | "ast" => pure ((Lean.toJson program).pretty ++ "\n")
    | "lean" => pure ("import Transpiler.AST\n\ndef program : Transpiler.Program :=\n" ++ reprStr program ++ "\n")
    | "check" =>
      let printed := printC program
      let again ← parseC printed
      unless printC again == printed do throw "printer/parser did not reach a stable canonical form"
      pure s!"OK: {program.items.length} top-level items\n"
    | "transpile" =>
      let result ← transpile (← loadRules) program
      let prelude :=  if kernel then "#include \"salty_compat.h\"\n" else
        "#include <stddef.h>\n#include <stdint.h>\n#include <math.h>\n"
      pure ("/* Generated by SALTy Lean transpiler; syntactic translation, not verified. */\n" ++
        helperLicense ++ "\n" ++ prelude ++ printC result)
    | _ => throw s!"unknown command {command}\n{usage}"
  let text ← match process with
    | .ok text => pure text
    | .error e => throw (IO.userError s!"{input}: {e}")
  match output with
  | some path => IO.FS.writeFile path text
  | none => (← IO.getStdout).putStr text

def main (args : List String) : IO UInt32 := do
  try
    run args
    return 0
  catch e =>
    (← IO.getStderr).putStrLn (toString e)
    return 1
